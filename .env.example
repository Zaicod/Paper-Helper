# Python worker configuration example. Never commit real keys.
# Embedding runs locally on the CPU; no embedding API key is required.
PAPERFLOW_CHROMA_DIR=outputs/chroma
# Optional: prepare a local folder, then uncomment this setting.
# PAPERFLOW_EMBEDDING_MODEL_DIR=outputs/models/multilingual-e5-small

# Agent report generation still requires a supported language-model API key.
# DASHSCOPE_API_KEY=replace-with-your-own-key
# QWEN_MODEL=replace-with-an-available-model
# OPENAI_API_KEY=replace-with-your-own-key
# OPENAI_MODEL=replace-with-an-available-model

# Java and Python must use the same internal service token (at least 32 characters).
# PAPERFLOW_SERVICE_TOKEN=replace-with-your-own-long-random-token
# PAPERFLOW_WORKER_URL=http://127.0.0.1:8001

# Optional Java Redis cache/rate limiting. Configure in Java's process environment.
# PAPERFLOW_REDIS_ENABLED=true
# PAPERFLOW_REDIS_HOST=127.0.0.1
# PAPERFLOW_REDIS_PORT=6379
# PAPERFLOW_REDIS_PASSWORD=replace-only-if-your-redis-requires-it
