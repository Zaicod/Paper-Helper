# 复制为 .env 后，CLI 与 Web 服务都会在启动时读取。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 阿里云百炼（华北2/北京）通用 API Key，可使用新人免费额度。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash
QWEN_EMBEDDING_MODEL=text-embedding-v4
# 旧公共域名可直接使用；生产环境建议改为控制台显示的业务空间专属 URL。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选的 DeepSeek Provider。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAlex 可匿名使用；免费注册 Key 可获得更高的每日调用额度。
OPENALEX_API_KEY=
# 论文资料库：不设置时 Web 版默认使用 outputs/paper_library.db
# MySQL 示例（密码包含特殊字符时需进行 URL 编码）
# PAPER_AGENT_DATABASE_URL=mysql+pymysql://paper_agent:change-me@127.0.0.1:3306/paper_agent?charset=utf8mb4

# 登录会话保存在 Redis；默认值如下。生产环境必须使用带密码/TLS 的 Redis。
PAPER_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# 默认 7 天，用户访问时会刷新 TTL。
PAPER_AGENT_SESSION_TTL_SECONDS=604800
# 只有 HTTPS 部署时设为 true；本地 HTTP 开发保持 false。
PAPER_AGENT_COOKIE_SECURE=false
# 生产环境必须固定设置 Fernet 密钥；本地未设置时会在 outputs/web 自动生成。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAPER_AGENT_SETTINGS_KEY=
