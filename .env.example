# 环境变量名称示例。当前 CLI 直接读取终端环境变量，不会自动加载此文件。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 阿里云百炼（华北2/北京）通用 API Key，可使用新人免费额度。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash
# 旧公共域名可直接使用；生产环境建议改为控制台显示的业务空间专属 URL。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAlex 可匿名使用；免费注册 Key 可获得更高的每日调用额度。
OPENALEX_API_KEY=
